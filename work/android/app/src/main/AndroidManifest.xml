<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The models are fetched on demand; nothing else here talks to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A ~275 MB transfer outlives the Activity, so it runs in a foreground service.
        POST_NOTIFICATIONS is a runtime grant from API 33; without it the service still
        runs, the user just cannot see it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.FaceFusion"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <!--
            The Hexagon DSP is reached through libcdsprpc.so, a VENDOR library.  It is
            listed in /vendor/etc/public.libraries.txt on this device, so it is linkable in
            principle, but from targetSdk 31 an app must ALSO name it here or the linker
            refuses it and libQnnHtpV79Stub.so fails to load:

                dlopen failed: library "libcdsprpc.so" not found:
                needed by libQnnHtpV79Stub.so in namespace clns-9

            which surfaces four layers up as the far less helpful
            "Failed to load skel, error: 4000" / "Device Creation failure".
        -->
        <uses-native-library android:name="libcdsprpc.so" android:required="true" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
