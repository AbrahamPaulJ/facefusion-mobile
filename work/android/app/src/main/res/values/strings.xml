    <!-- ==================================================== content gate
         The one place where a soft translation changes what the app appears to promise.
         BLOCK is a refusal and must read as one; ERROR must NOT read as a refusal, because
         a check that could not run has neither permitted nor refused anything, and saying
         "not allowed" there blames the user for our own failure. -->
    <string name="gate_subject_source_image">the source image</string>
    <string name="gate_subject_target_image">the target image</string>
    <string name="gate_subject_target_video">the target video</string>
    <string name="gate_subject_this_frame">this frame</string>
    <!-- %1$s is one of the gate_subject_* strings above -->
    <string name="gate_blocked">Explicit content not allowed in %1$s</string>
    <string name="gate_error">The content check could not run on %1$s, so it cannot be processed</string>
    <!-- %1$s is the gate_error sentence, %2$s a technical reason that is not translated -->
